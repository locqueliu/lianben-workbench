{
  "name": "@local/lianben-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lianben Workbench v1.0: deterministic preflight, refine (director) and BGM stages with async jobs, live output, cost ledger, budget/lock hardening and legacy migration.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "engine/**",
    "engine2/**",
    "prompts/**",
    "lib/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "Apache-2.0",
  "author": "locqueliu",
  "repository": {
    "type": "git",
    "url": "https://github.com/locqueliu/lianben-workbench.git"
  },
  "homepage": "https://github.com/locqueliu/lianben-workbench"
}
